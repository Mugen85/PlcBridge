@page "/"
@rendermode InteractiveServer
@implements IAsyncDisposable
@inject IPlcService PlcService
@using PlcBridge.Core.Interfaces
@using PlcBridge.Core.Models

<PageTitle>PlcBridge - HMI Dashboard</PageTitle>

<div class="container mt-4">
    <div class="row mb-4">
        <div class="col">
            <h1 class="display-6 fw-bold text-dark">
                <i class="bi bi-cpu text-primary"></i> PlcBridge HMI Panel
            </h1>
            <p class="text-muted">Supervisione e controllo impianto in tempo reale</p>
        </div>
    </div>

    <!-- Indicatori di Campo (Sensori) -->
    <div class="row g-4 mb-4">
        <!-- Temperatura -->
        <div class="col-md-6">
            <div class="card shadow-sm border-0 bg-light">
                <div class="card-body">
                    <h5 class="card-title text-secondary">Temperatura Impianto</h5>
                    <div class="display-4 fw-bold text-dark my-2">
                        @_status.Temperature.ToString("F1") <span class="fs-4 text-muted">°C</span>
                    </div>
                    <div class="progress" style="height: 8px;">
                        <div class="progress-bar bg-danger" role="progressbar" style="width: @((_status.Temperature / 85.0) * 100)%"></div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Pressione -->
        <div class="col-md-6">
            <div class="card shadow-sm border-0 bg-light">
                <div class="card-body">
                    <h5 class="card-title text-secondary">Pressione Circuito</h5>
                    <div class="display-4 fw-bold text-dark my-2">
                        @_status.Pressure.ToString("F1") <span class="fs-4 text-muted">BAR</span>
                    </div>
                    <div class="progress" style="height: 8px;">
                        <div class="progress-bar bg-primary" role="progressbar" style="width: @((_status.Pressure / 16.0) * 100)%"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Pannello Controllo Attuatori -->
    <div class="row">
        <div class="col-12">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-white py-3">
                    <h5 class="mb-0 fw-bold">Stato Attuatori & Comandi</h5>
                </div>
                <div class="card-body">
                    <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
                        <!-- Indicatore Stato Pompa -->
                        <div class="d-flex align-items-center gap-3">
                            <span class="fw-semibold">Stato Pompa Principale:</span>
                            @if (_status.IsPumpRunning)
                            {
                                <span class="badge bg-success fs-6 px-3 py-2">IN ESECUZIONE (ON)</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary fs-6 px-3 py-2">FERMA (OFF)</span>
                            }
                        </div>

                        <!-- Pulsantiera Operatore -->
                        <div class="d-flex gap-2">
                            <button class="btn btn-success px-4 py-2 fw-bold" 
                                    @onclick="StartPump" 
                                    disabled="@_status.IsPumpRunning">
                                <i class="bi bi-play-fill"></i> AVVIA POMPA
                            </button>
                            <button class="btn btn-danger px-4 py-2 fw-bold" 
                                    @onclick="StopPump" 
                                    disabled="@(!_status.IsPumpRunning)">
                                <i class="bi bi-stop-fill"></i> ARRESTA POMPA
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private PlcSystemStatus _status = new(22.0, 12.0, false);
    private PeriodicTimer? _timer;
    private CancellationTokenSource? _cts;

    protected override async Task OnInitializedAsync()
    {
        _status = await PlcService.GetSystemStatusAsync();

        _cts = new CancellationTokenSource();
        _timer = new PeriodicTimer(TimeSpan.FromSeconds(1));

        _ = PollDataAsync(_cts.Token);
    }

    private async Task PollDataAsync(CancellationToken cancellationToken)
    {
        try
        {
            while (await _timer!.WaitForNextTickAsync(cancellationToken))
            {
                _status = await PlcService.GetSystemStatusAsync(cancellationToken);
                StateHasChanged();
            }
        }
        catch (OperationCanceledException)
        {
            // Chiusura pulita
        }
    }

    private async Task StartPump()
    {
        await PlcService.StartPumpAsync();
        _status = await PlcService.GetSystemStatusAsync();
    }

    private async Task StopPump()
    {
        await PlcService.StopPumpAsync();
        _status = await PlcService.GetSystemStatusAsync();
    }

    public async ValueTask DisposeAsync()
    {
        if (_cts != null)
        {
            _cts.Cancel();
            _cts.Dispose();
        }
        _timer?.Dispose();
    }
}